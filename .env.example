# ---------------------------------------------------------------------
# AUTH
# ---------------------------------------------------------------------
JWT_SECRET_KEY=your_super_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

AUTH_ENABLE_COMPANY_DOMAIN_WORKSPACES=true
AUTH_PUBLIC_EMAIL_DOMAINS=gmail.com,googlemail.com,outlook.com,hotmail.com,live.com,yahoo.com,icloud.com,me.com,proton.me,protonmail.com,aol.com,mail.com,yandex.com

# ---------------------------------------------------------------------
# POSTGRES
# ---------------------------------------------------------------------
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=secret123
POSTGRES_DB=financial_rag_db
POSTGRES_PORT=5432

POSTGRES_URL=postgresql+asyncpg://rag_user:secret123@postgres:5432/financial_rag_db

# ---------------------------------------------------------------------
# QDRANT CLOUD
# ---------------------------------------------------------------------
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_TIMEOUT=60.0

# ---------------------------------------------------------------------
# MINIO / LOCAL S3
# ---------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=financial-documents

# ---------------------------------------------------------------------
# OPENAI
# ---------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------
# RAG STORAGE
# ---------------------------------------------------------------------
RAG_COLLECTION_NAME=finance_documents
RAG_DUCKDB_PATH=/data/finance.duckdb
RAG_GLOBAL_WORKSPACE_ID=00000000-0000-0000-0000-000000000001

# ---------------------------------------------------------------------
# CHUNKING
# ---------------------------------------------------------------------
RAG_CHUNK_MAX_TOKENS=1000
RAG_CHUNK_OVERLAP_TOKENS=120
RAG_CHUNK_MIN_TOKENS=25
RAG_CHUNK_MERGE_RATIO=0.85

# ---------------------------------------------------------------------
# EMBEDDINGS
# ---------------------------------------------------------------------
RAG_USE_OPENAI_EMBEDDINGS=true
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_EMBEDDING_DIMENSIONS=3072
RAG_EMBEDDING_BATCH_SIZE=64
RAG_EMBEDDING_MAX_INPUT_TOKENS=7500

RAG_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_LOCAL_EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------------
# RETRIEVAL
# ---------------------------------------------------------------------
RAG_RETRIEVAL_TOP_K=8
RAG_PREFETCH_MIN=40
RAG_FUSION_MIN=30
RAG_FIRST_STAGE_MULTIPLIER=5
RAG_FUSION_MULTIPLIER=3

# ---------------------------------------------------------------------
# RERANKER
# ---------------------------------------------------------------------
RAG_USE_RERANKER=true
RAG_RERANKER_MODE=auto
RAG_CPU_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_GPU_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_MAX_LENGTH=1024
RAG_RERANKER_BATCH_SIZE=16

# ---------------------------------------------------------------------
# RUNTIME
# ---------------------------------------------------------------------
RAG_INGESTION_CONCURRENCY=1
RAG_THREAD_POOL_WORKERS=8

# ---------------------------------------------------------------------
# AGENT
# ---------------------------------------------------------------------
RAG_AGENT_MODEL=gpt-5-mini
RAG_AGENT_REASONING_EFFORT=low
RAG_AGENT_MAX_TOOL_TURNS=15
RAG_AGENT_MAX_TOKENS=2000
RAG_AGENT_TEMPERATURE=0.0
RAG_AGENT_TRACE_PATH=/data/agent_traces.jsonl
RAG_AGENT_MAX_TOOL_OUTPUT_CHARS=12000
RAG_CITATION_URL_EXPIRES_SECONDS=600

# ---------------------------------------------------------------------
# CHAINLIT
# ---------------------------------------------------------------------
CHAINLIT_AUTH_SECRET=change-me-chainlit-secret
BACKEND_BASE_URL=http://api:8000/api/v1