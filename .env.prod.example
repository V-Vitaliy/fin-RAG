# Copy this file to .env.prod on the server and fill real secrets.
# Do not commit .env.prod.

# ---------------------------------------------------------------------
# PATHS USED BY docker-compose.prod.yml
# ---------------------------------------------------------------------
FINRAG_DATA_ROOT=/srv/finrag/data
FINRAG_IMPORT_ROOT=/srv/finrag/import
FINRAG_MODELS_ROOT=/srv/finrag/models

# ---------------------------------------------------------------------
# AUTH
# ---------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_ENABLE_COMPANY_DOMAIN_WORKSPACES=true
AUTH_PUBLIC_EMAIL_DOMAINS=gmail.com,googlemail.com,outlook.com,hotmail.com,live.com,yahoo.com,icloud.com,me.com,proton.me,protonmail.com,aol.com,mail.com,yandex.com

# ---------------------------------------------------------------------
# POSTGRES - internal Docker network only
# ---------------------------------------------------------------------
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=financial_rag_db
POSTGRES_URL=postgresql+asyncpg://rag_user:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/financial_rag_db

# ---------------------------------------------------------------------
# QDRANT - self-hosted, internal Docker network; localhost admin port on host
# ---------------------------------------------------------------------
QDRANT_IMAGE=qdrant/qdrant:latest
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_TIMEOUT=60.0
# QDRANT_API_KEY=  # keep unset unless you explicitly enable Qdrant API key auth

# ---------------------------------------------------------------------
# AWS S3 managed storage for uploaded PDFs
# Recommended: attach an IAM role to the EC2 instance and keep access keys unset.
# If you do not use an IAM role, uncomment and set access keys.
# ---------------------------------------------------------------------
AWS_REGION=eu-central-1
AWS_DEFAULT_REGION=eu-central-1
S3_BUCKET_NAME=finrag-prod-documents
# S3_ENDPOINT_URL is intentionally unset for real AWS S3.
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...

# ---------------------------------------------------------------------
# OPENAI
# ---------------------------------------------------------------------
OPENAI_API_KEY=CHANGE_ME_OPENAI_KEY

# ---------------------------------------------------------------------
# RAG STORAGE
# ---------------------------------------------------------------------
RAG_COLLECTION_NAME=finance_documents
RAG_DUCKDB_PATH=/data/duckdb/finance.duckdb
RAG_GLOBAL_WORKSPACE_ID=00000000-0000-0000-0000-000000000001

# ---------------------------------------------------------------------
# CHUNKING
# ---------------------------------------------------------------------
RAG_CHUNK_MAX_TOKENS=1000
RAG_CHUNK_OVERLAP_TOKENS=120
RAG_CHUNK_MIN_TOKENS=25
RAG_CHUNK_MERGE_RATIO=0.85

# ---------------------------------------------------------------------
# EMBEDDINGS
# ---------------------------------------------------------------------
RAG_USE_OPENAI_EMBEDDINGS=true
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_EMBEDDING_DIMENSIONS=3072
RAG_EMBEDDING_BATCH_SIZE=64
RAG_EMBEDDING_MAX_INPUT_TOKENS=7500
RAG_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_LOCAL_EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------------
# RETRIEVAL
# ---------------------------------------------------------------------
RAG_RETRIEVAL_TOP_K=8
RAG_PREFETCH_MIN=40
RAG_FUSION_MIN=30
RAG_FIRST_STAGE_MULTIPLIER=5
RAG_FUSION_MULTIPLIER=3

# ---------------------------------------------------------------------
# RERANKER - CPU by default on m7i; use gpu_heavy only on GPU instances.
# ---------------------------------------------------------------------
RAG_USE_RERANKER=true
RAG_RERANKER_MODE=cpu_light
RAG_CPU_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_GPU_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_MAX_LENGTH=1024
RAG_RERANKER_BATCH_SIZE=16

# ---------------------------------------------------------------------
# RUNTIME
# ---------------------------------------------------------------------
RAG_INGESTION_CONCURRENCY=1
RAG_THREAD_POOL_WORKERS=8

# ---------------------------------------------------------------------
# AGENT
# ---------------------------------------------------------------------
RAG_AGENT_MODEL=gpt-5-mini
RAG_AGENT_REASONING_EFFORT=low
RAG_AGENT_MAX_TOOL_TURNS=15
RAG_AGENT_MAX_TOKENS=2000
RAG_AGENT_TEMPERATURE=0.0
RAG_AGENT_TRACE_PATH=/data/evals/agent_traces.jsonl
RAG_AGENT_MAX_TOOL_OUTPUT_CHARS=12000
RAG_CITATION_URL_EXPIRES_SECONDS=600

# ---------------------------------------------------------------------
# UI is public for demo access. API is internal-only and called by UI over Docker network.
# ---------------------------------------------------------------------
UI_BIND_HOST=0.0.0.0
UI_PORT=8001
BACKEND_BASE_URL=http://api:8000/api/v1
CHAINLIT_AUTH_SECRET=CHANGE_ME_CHAINLIT_SECRET

# ---------------------------------------------------------------------
# BACKUPS
# ---------------------------------------------------------------------
BACKUP_ROOT=/srv/finrag/backups
# Optional; if set, backup script uploads backup files here.
# BACKUP_S3_URI=s3://finrag-prod-artifacts/backups
